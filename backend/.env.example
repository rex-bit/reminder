# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (Nginx = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY=0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://reminder:reminder_dev_only@localhost:5432/reminder
# Set true if your Postgres requires TLS
DATABASE_SSL=false

# --- Auth ---
# Generate: openssl rand -base64 48   (min 32 chars)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# --- CORS / cookies ---
# Comma-separated list of exact frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Production behind HTTPS: COOKIE_SECURE=true
# Frontend on GitHub Pages (different site than the API): COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- App defaults ---
DEFAULT_TIMEZONE=Asia/Jakarta

# --- First Owner account (used by `npm run seed` only when no owner exists) ---
OWNER_USERNAME=owner
OWNER_EMAIL=
# 12-72 characters. Change it after first login.
OWNER_PASSWORD=

# --- Bot service auth (used from Phase 4) ---
# Generate: openssl rand -base64 48
BOT_API_KEY=
