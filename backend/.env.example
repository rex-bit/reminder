# --- Server ---
NODE_ENV=development
PORT=4000
# Bind address. Keep 0.0.0.0 on Pterodactyl (the port is then published on the allocation IP, e.g. 127.0.0.1).
HOST=0.0.0.0
LOG_LEVEL=info
# Number of reverse proxies in front of the app (Nginx = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY=0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://reminder:reminder_dev_only@localhost:5432/reminder
# Set true if your Postgres requires TLS
DATABASE_SSL=false

# --- Auth ---
# Generate: openssl rand -base64 48   (min 32 chars)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# --- CORS / cookies ---
# Comma-separated list of exact frontend origins (no trailing slash), e.g. https://app.example.com (Vercel custom domain)
CORS_ORIGINS=http://localhost:5173
# Production behind HTTPS: COOKIE_SECURE=true
# Frontend on GitHub Pages (different site than the API): COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- App defaults ---
DEFAULT_TIMEZONE=Asia/Jakarta

# --- First Owner account (used by `npm run seed` only when no owner exists) ---
OWNER_USERNAME=owner
OWNER_EMAIL=
# 12-72 characters. Change it after first login.
OWNER_PASSWORD=

# --- Web Push notifications (reminder becomes "due" -> admins get a notification) ---
# Generate once: npx web-push generate-vapid-keys   (keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Queue (Redis) ---
REDIS_URL=redis://localhost:6379
# false = do not start the delivery worker inside the API process
RUN_WORKER=true
DELIVERY_MAX_ATTEMPTS=5

# --- Bot service (Phase 4) ---
# Base URL of the WhatsApp bot service, e.g. http://127.0.0.1:4100. Empty = deliveries fail with bot_not_configured.
BOT_SERVICE_URL=
# --- Bot service auth ---
# Generate: openssl rand -base64 48
BOT_API_KEY=
