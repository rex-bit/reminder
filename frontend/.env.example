# Public build-time values only. Never put secrets here: everything in this file ships to the browser.
# Base URL of the backend REST API (HTTPS in production).
VITE_API_URL=http://localhost:4000/api/v1
# Public path the site is served from. "/" for root, "/<repo-name>/" for GitHub Pages.
VITE_BASE=/
# Local development / Codespaces: use the dev proxy instead (VITE_API_URL=/api/v1), see vite.config.ts.
