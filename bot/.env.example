NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# Number of reverse proxies in front (Nginx = 1)
TRUST_PROXY=0

# --- Shared secret with the backend (same value as BOT_API_KEY in backend/.env). Generate: openssl rand -base64 48
BOT_API_KEY=
# Where to forward delivery status updates, e.g. https://api.example.com
BACKEND_URL=http://localhost:4000

# --- Meta WhatsApp Cloud API (from your Meta app dashboard). Keep these server-side only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret (Meta app > Settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string you also enter in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Graph API version path segment. Check Meta's changelog and keep it current.
GRAPH_API_VERSION=v21.0

# --- Message mode
# Empty = free-form text messages. Meta only delivers these inside the 24-hour window after the recipient last messaged your number.
# Set an APPROVED template name to send business-initiated reminders (body must contain exactly one variable {{1}}).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id

# --- Groups API (off by default; read docs/WHATSAPP.md before enabling)
WHATSAPP_GROUPS_ENABLED=false

# --- Idempotency store. Empty = in-process memory (lost on restart); recommended: the same Redis as the backend
REDIS_URL=
